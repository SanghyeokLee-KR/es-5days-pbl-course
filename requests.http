POST /shop-logs/_analyze
{ "analyzer": "log_message_analyzer", "text": "재시도" }

POST /shop-logs/_analyze
{ "analyzer": "whitespace", "text": "재시도" }

POST /shop-logs/_analyze
{ "analyzer": "standard", "text": "정상적으로 완료" }

POST /shop-logs/_analyze
{ "analyzer": "log_message_analyzer", "text": "정상적으로 완료" }

POST /shop-logs/_analyze
{ "analyzer": "whitespace", "text": "정상적으로 완료" }

